<Project>

  <!-- Directory.Build.props resolution stops at the first file found, so the root must be
       imported explicitly or its settings would be silently lost for test projects. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: test method names use underscores for readability.
         CA2007: ConfigureAwait is not needed; tests have no synchronization context.
         CA1711: xUnit collection definitions conventionally end in "Collection".
         xUnit1041: fixture-constructor-argument rule is noisy with collection fixtures. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1711;xUnit1041</NoWarn>
  </PropertyGroup>

</Project>
